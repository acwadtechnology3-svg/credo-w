# From Supabase → Project Settings → API (use service_role for server only — never expose in frontend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Frontend (Vite) — same URL + anon/publishable key for Google OAuth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Vercel demo (frontend-only): mocks API + disables sockets (set in vercel.json build)
# VITE_DEMO_MODE=true
# Optional demo persona: member | admin | super_admin
# VITE_DEMO_ROLE=member
# Point to Railway/Render API when backend is deployed (omit on Vercel demo)
# VITE_API_URL=
# VITE_SOCKET_URL=
# For npm run db:setup — Supabase → Database → Connection string → URI
DATABASE_URL=
JWT_SECRET=your_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
PORT=3001
NODE_ENV=development
REGISTER_AUTO_ACTIVE=true
# Gmail SMTP (use App Password: https://myaccount.google.com/apppasswords)
SMTP_EMAIL=
SMTP_PASSWORD=
# Optional — welcome email branding
# CLIENT_ORIGIN=http://localhost:5173
# SUPPORT_EMAIL=support@credow.com
# EMAIL_LOGO_URL=https://your-domain.com/credo-email-logo.png
