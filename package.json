{
  "name": "credo-w",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "lsof -ti :3001 | xargs kill -9 2>/dev/null || true; node --watch-path=server --watch server/index.js",
    "build": "vite build",
    "build:demo": "VITE_DEMO_MODE=true vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "db:setup": "node scripts/setup-database.mjs",
    "test:shop": "node scripts/test-shop-flow.mjs",
    "test:phase5": "node scripts/verify-phase5.mjs",
    "test:phase7": "node scripts/verify-phase7.mjs",
    "db:shop": "node scripts/apply-shop-sql.mjs",
    "db:invitations": "node scripts/apply-invitations-sql.mjs",
    "db:support-rls": "node scripts/apply-support-rls.mjs",
    "install:all": "npm install",
    "test:phase9": "node scripts/verify-phase9.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.0",
    "@xyflow/react": "^12.3.6",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "i18next": "^26.2.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.447.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
