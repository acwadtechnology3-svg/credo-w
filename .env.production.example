# Frontend (Vercel) — copy to Vercel Environment Variables
#
# PRODUCTION (required for real accounts & data):
# VITE_API_URL=https://your-app.railway.app
# VITE_SOCKET_URL=https://your-app.railway.app
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
#
# DEMO ONLY (UI walkthrough — mocks API, no real DB):
# VITE_DEMO_MODE=true
# VITE_DEMO_ROLE=member
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
