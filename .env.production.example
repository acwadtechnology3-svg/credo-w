# Frontend (Vercel) — copy to Vercel Environment Variables
#
# DEMO (frontend-only on Vercel — default in vercel.json):
#   Leave VITE_API_URL unset OR set VITE_DEMO_MODE=true
#   Sockets disabled; API responses mocked for UI walkthrough
#
# LIVE API (when backend is deployed separately):
# VITE_API_URL=https://your-app.railway.app
# VITE_SOCKET_URL=https://your-app.railway.app
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
